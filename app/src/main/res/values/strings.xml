    <string name="awaaz_title">Meri Awaaz</string>
    <string name="awaaz_intro">Amla learns your sound habits on your phone only. Nothing leaves your phone.</string>
    <string name="awaaz_learn">Learn my habits</string>
    <string name="awaaz_learn_info">When on, Amla remembers the EQ changes you make. It only suggests — it never changes your sound by itself.</string>
    <string name="awaaz_enable_title">Learn my habits?</string>
    <string name="awaaz_enable_message">Amla will save details of the EQ changes you make (device, time, app if allowed) in a local database. Nothing is uploaded. You can delete everything anytime, and suggestions always need your approval.</string>
    <string name="awaaz_see">See what Amla remembers</string>
    <string name="awaaz_delete">Delete everything</string>
    <string name="awaaz_delete_message">Delete all saved sound events from this phone?</string>
