    <string name="background_keep_alive">Keep EQ active in background</string>
    <string name="background_keep_alive_subtitle">Only used with Always on mode</string>

    <string name="mood_title">Desi sound moods</string>
    <string name="mood_info">Tap a mood to change the sound instantly. Each mood is just a ready-made combination of the EQ, bass, surround, loudness and reverb you already know — nothing is downloaded.</string>
    <string name="mood_chai_time">Chai Time</string>
