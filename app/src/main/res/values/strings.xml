    <string name="soft_start_title">Soft start</string>
    <string name="soft_start_subtitle">Gradually raise the volume when you connect a new output</string>
    <string name="soft_start_info">When headphones, a USB DAC or Bluetooth connect, Amla starts the music at a low volume and slowly raises it to your current level. This helps protect your ears from a sudden loud sound. It changes only the system media volume, never your saved EQ.</string>
